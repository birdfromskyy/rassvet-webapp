[Unit]
Description=Rassvet restic repository maintenance
Documentation=https://restic.readthedocs.io/
ConditionPathExists=/etc/rassvet-backup/restic.env
ConditionPathExists=/etc/rassvet-backup/restic-password

[Service]
Type=oneshot
Environment=TZ=Asia/Yekaterinburg
ExecStart=/usr/local/sbin/rassvet-backup maintenance
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryHigh=650M
MemoryMax=850M
TasksMax=100
TimeoutStartSec=infinity
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=rassvet-backup
RuntimeDirectoryMode=0700
StateDirectory=rassvet-backup
StateDirectoryMode=0700
CacheDirectory=restic
CacheDirectoryMode=0700
ReadWritePaths=/var/backups/rassvet-restic
