server {
    server_name {{ rassvet_domain }} {{ rassvet_www_domain }};
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_proxied any;
    gzip_types application/json text/plain application/javascript text/css text/xml;
    gzip_min_length 1024;
    gzip_vary on;

    limit_req_status 429;
    limit_req_log_level warn;

    location ~* ^/(?:[^/?]+/)*(?:\.env(?:[./?]|$)|\.git(?:[/?]|$)|\.git-credentials(?:[/?]|$)|actuator(?:[/?]|$)|wp-login\.php(?:[?]|$)|xmlrpc\.php(?:[?]|$)|phpmyadmin(?:[/?]|$)|vendor/phpunit(?:[/?]|$)|cgi-bin(?:[/?]|$)) {
        return 404;
    }

    location /api/ {
        limit_req zone=rassvet_auth burst=30 nodelay;
        proxy_pass http://{{ rassvet_backend_ip }}:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 25M;
    }

    location /uploads/ {
        proxy_pass http://{{ rassvet_backend_ip }}:8080;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location / {
        proxy_pass http://{{ rassvet_frontend_ip }}:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://{{ rassvet_domain }}; font-src 'self' data: https:; media-src 'self' https:; frame-src https://vk.com https://*.vk.com https://vk.ru https://*.vk.ru https://vkvideo.ru https://*.vkvideo.ru https://yandex.ru https://*.yandex.ru; frame-ancestors 'none';" always;
    }

    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/{{ rassvet_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ rassvet_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name {{ rassvet_domain }} {{ rassvet_www_domain }};
    return 301 https://$host$request_uri;
}
