[Unit]
Description=Rassvet Webapp (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ rassvet_app_dir }}
ExecStart=/usr/local/sbin/rassvet-release start
ExecStop=/usr/local/sbin/rassvet-release stop
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
