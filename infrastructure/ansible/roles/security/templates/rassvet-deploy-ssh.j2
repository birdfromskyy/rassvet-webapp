#!/bin/sh
set -eu

case "${SSH_ORIGINAL_COMMAND:-}" in
  health)
    exec /usr/bin/curl --fail --silent --show-error --max-time 10 \
      https://{{ rassvet_domain }}/api/health
    ;;
  status)
    /usr/bin/systemctl is-active rassvet.service
    exec /usr/bin/curl --fail --silent --show-error --max-time 10 \
      https://{{ rassvet_domain }}/api/health
    ;;
  *)
    echo "Deploy access is restricted. Allowed commands: status, health." >&2
    exit 126
    ;;
esac
