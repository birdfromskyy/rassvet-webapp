{
	"collections": [
		{
			"collection": "articles",
			"meta": {
				"collection": "articles",
				"icon": "article",
				"note": "News and blog articles",
				"display_template": "{{title}}",
				"hidden": false,
				"singleton": false,
				"translations": null,
				"archive_field": "status",
				"archive_app_filter": true,
				"archive_value": "archived",
				"unarchive_value": "draft",
				"sort_field": "sort"
			},
			"fields": [
				{
					"field": "id",
					"type": "uuid",
					"meta": {
						"hidden": true,
						"readonly": true,
						"interface": "input",
						"special": ["uuid"]
					}
				},
				{
					"field": "status",
					"type": "string",
					"meta": {
						"width": "full",
						"options": {
							"choices": [
								{ "text": "Draft", "value": "draft" },
								{ "text": "Published", "value": "published" },
								{ "text": "Archived", "value": "archived" }
							]
						},
						"interface": "select-dropdown",
						"display": "labels"
					}
				},
				{
					"field": "title",
					"type": "string",
					"meta": {
						"width": "full",
						"interface": "input",
						"required": true
					}
				},
				{
					"field": "slug",
					"type": "string",
					"meta": {
						"width": "full",
						"interface": "input",
						"note": "URL-friendly version of the title",
						"required": true
					}
				},
				{
					"field": "summary",
					"type": "text",
					"meta": {
						"width": "full",
						"interface": "input-multiline"
					}
				},
				{
					"field": "content",
					"type": "text",
					"meta": {
						"width": "full",
						"interface": "input-rich-text-html"
					}
				},
				{
					"field": "featured_image",
					"type": "uuid",
					"meta": {
						"width": "full",
						"interface": "file-image",
						"special": ["file"]
					}
				},
				{
					"field": "category",
					"type": "string",
					"meta": {
						"width": "half",
						"interface": "select-dropdown",
						"options": {
							"choices": [
								{ "text": "Новости", "value": "news" },
								{ "text": "Статьи", "value": "articles" },
								{ "text": "Обновления", "value": "updates" },
								{ "text": "События", "value": "events" }
							]
						}
					}
				},
				{
					"field": "tags",
					"type": "json",
					"meta": {
						"width": "half",
						"interface": "tags"
					}
				},
				{
					"field": "author",
					"type": "string",
					"meta": {
						"width": "half",
						"interface": "input"
					}
				},
				{
					"field": "published_at",
					"type": "timestamp",
					"meta": {
						"width": "half",
						"interface": "datetime"
					}
				},
				{
					"field": "view_count",
					"type": "integer",
					"meta": {
						"width": "half",
						"interface": "input",
						"readonly": true
					}
				},
				{
					"field": "meta_title",
					"type": "string",
					"meta": {
						"width": "full",
						"interface": "input",
						"note": "SEO title"
					}
				},
				{
					"field": "meta_description",
					"type": "text",
					"meta": {
						"width": "full",
						"interface": "input-multiline",
						"note": "SEO description"
					}
				}
			]
		}
	]
}
